<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jarvis_bg"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <Space
        android:layout_width="match_parent"
        android:layout_height="60dp" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JARVIS"
        android:textColor="@color/jarvis_accent"
        android:textSize="34sp"
        android:letterSpacing="0.25"
        android:fontFamily="sans-serif-light" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Standing by"
        android:textColor="@color/jarvis_text_dim"
        android:textSize="14sp" />

    <View
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/circle_indicator"
        android:id="@+id/indicatorCircle" />

    <Button
        android:id="@+id/toggleButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="56dp"
        android:text="Activate Jarvis"
        android:backgroundTint="@color/jarvis_accent_dim"
        android:textColor="@color/jarvis_text" />

    <EditText
        android:id="@+id/apiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Paste free Groq API key (optional)"
        android:textColorHint="@color/jarvis_text_dim"
        android:textColor="@color/jarvis_text"
        android:inputType="textPassword"
        android:singleLine="true" />

    <Button
        android:id="@+id/saveKeyButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Save Key"
        android:backgroundTint="@color/jarvis_accent_dim"
        android:textColor="@color/jarvis_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Say &quot;Jarvis&quot; any time, screen on or off, to wake me."
        android:textColor="@color/jarvis_text_dim"
        android:textSize="12sp"
        android:gravity="center" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jarvis_text"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>

